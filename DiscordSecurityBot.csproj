<Project Sdk="Microsoft.NET.Sdk">
	<!-- Основные настройки сборки -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<ImplicitUsings>disable</ImplicitUsings>
		<IsPublishable>True</IsPublishable>
		<PlatformTarget>x64</PlatformTarget>
		<Platforms>x64</Platforms>
		<ProduceReferenceAssembly>False</ProduceReferenceAssembly>
		<ErrorReport>none</ErrorReport>
	</PropertyGroup>

	<!-- Lang version -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>14.0</LangVersion>
	</PropertyGroup>

	<!-- Error levels -->
	<PropertyGroup>
		<Nullable>enable</Nullable>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisLevel>latest-all</AnalysisLevel>
		<WarningLevel>9999</WarningLevel>
	</PropertyGroup>

	<!-- Version -->
	<PropertyGroup>
		<VersionPrefix>1.5.0</VersionPrefix>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
	</PropertyGroup>

	<Target Name="SetGitRevision" BeforeTargets="GetAssemblyVersion">
		<Exec Command="git rev-list --count HEAD"
			  ConsoleToMSBuild="true">
			<Output TaskParameter="ConsoleOutput"
					PropertyName="_GitRevision" />
		</Exec>

		<PropertyGroup>
			<_GitRevision Condition="'$(_GitRevision)' == ''">0</_GitRevision>

			<Version>$(VersionPrefix).$(_GitRevision)</Version>
			<AssemblyVersion>$(Version)</AssemblyVersion>
			<FileVersion>$(Version)</FileVersion>
			<InformationalVersion>$(Version)</InformationalVersion>
		</PropertyGroup>
	</Target>

	<Target Name="PrintVersion" DependsOnTargets="SetGitRevision">
		<Message Text="PROJECT_VERSION=$(Version)" Importance="High" />
	</Target>

	<!-- Настройки путей сборки -->
	<PropertyGroup>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
	</PropertyGroup>

	<!-- NuGet -->
	<ItemGroup>
	  <PackageReference Include="ClosedXML" Version="0.105.1" />
	  <PackageReference Include="Discord.Net" Version="3.20.2" />
	  <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
	  <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
	  <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
	</ItemGroup>

	<!-- Config files -->
	<ItemGroup>
	  <None Update="appsettings.Development.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="appsettings.json">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <EditorConfigFiles Remove=".editorconfig" />
	  <None Include=".editorconfig" />
	</ItemGroup>

</Project>
